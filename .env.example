# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=russia_ecommerce

# DeepSeek V4 Flash API（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=

# 火山引擎翻译 API（https://www.volcengine.com/product/translate）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# ============================================================
# GitHub Webhook（自动部署用）
# 在 GitHub 仓库 Settings → Webhooks 中设置
# Secret 必须与 GitHub 上设置的一致
# ============================================================
GITHUB_WEBHOOK_SECRET=
# 部署通知机器人（可选，支持飞书/钉钉 Webhook URL）
# WEBHOOK_NOTIFY_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
